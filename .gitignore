# Environment and secrets
.env
.env.*
!.env.example

# Composer dependencies
/vendor/

# CodeIgniter 4 writable runtime files
/writable/cache/*
!/writable/cache/.htaccess
/writable/cache/index.html
/writable/logs/*
!/writable/logs/.htaccess
/writable/logs/index.html
/writable/session/*
!/writable/session/.htaccess
/writable/session/index.html
/writable/debugbar/*
!/writable/debugbar/.htaccess
/writable/debugbar/index.html

# User-uploaded files (runtime uploads, not app-managed default images)
/writable/uploads/*
!/writable/uploads/.htaccess
!/writable/uploads/index.html

# Frontend dependencies and generated assets
/node_modules/
/public/build/
/public/hot

# IDE and editor files
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.example.json
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.bak
*.orig

# Test and coverage output
.phpunit.cache/
/coverage/

# Local development databases / dumps
*.sqlite
*.sqlite3
*.db
*.sql.gz
